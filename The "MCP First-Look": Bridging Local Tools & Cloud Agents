import fs from 'fs';
import path from 'path';
import pino from 'pino';
import { promisify } from 'util';

interface AuditEntry {
  timestamp: string;
  requestId: string;
  query: string;
  operation: string;
  rowCount?: number;
  status: 'success' | 'failed';
  reason?: string;
  duration: number;
  apiKey?: string;
  userId?: string;
}

/**
 * Audit Logger
 * Maintains a complete audit trail of all database queries and security events
 */
export class AuditLogger {
  private logger: pino.Logger;
  private auditLogPath: string;
  private maxLogSize: number = 100 * 1024 * 1024; // 100MB
  private enableAudit: boolean;
  private writeStream: fs.WriteStream | null = null;
  private queryBuffer: AuditEntry[] = [];
  private bufferFlushInterval: NodeJS.Timeout | null = null;

  constructor() {
    this.logger = pino();
    this.auditLogPath = process.env.AUDIT_LOG_PATH || './logs/audit.log';
    this.enableAudit = process.env.ENABLE_AUDIT_LOG !== 'false';
    
    this.initializeAuditLogging();
  }

  /**
   * Initialize audit logging
   */
  private initializeAuditLogging(): void {
    if (!this.enableAudit) {
      this.logger.info('Audit logging disabled');
      return;
    }

    try {
      // Ensure log directory exists
      const logDir = path.dirname(this.auditLogPath);
      if (!fs.existsSync(logDir)) {
        fs.mkdirSync(logDir, { recursive: true });
      }

      // Create write stream
      this.writeStream = fs.createWriteStream(this.auditLogPath, { flags: 'a' });

      // Flush buffer periodically
      this.bufferFlushInterval = setInterval(() => {
        this.flushBuffer();
      }, 5000); // Every 5 seconds

      this.logger.info({ auditLogPath: this.auditLogPath }, 'Audit logging initialized');
    } catch (error: any) {
      this.logger.error(error, 'Failed to initialize audit logging');
    }
  }

  /**
   * Log successful query execution
   */
  logQuery(
    requestId: string,
    query: string,
    operation: string,
    rowCount: number,
    duration: number = 0,
    apiKey?: string
  ): void {
    if (!this.enableAudit) {
      return;
    }

    const entry: AuditEntry = {
      timestamp: new Date().toISOString(),
      requestId,
      query: this.truncateQuery(query),
      operation,
      rowCount,
      status: 'success',
      duration,
      apiKey: this.hashKey(apiKey),
    };

    this.queryBuffer.push(entry);
    this.logger.debug({ ...entry }, 'Query logged');
  }

  /**
   * Log failed query attempt
   */
  logFailedAttempt(
    requestId: string,
    query: string,
    reason: string,
    apiKey?: string
  ): void {
    if (!this.enableAudit) {
      return;
    }

    const entry: AuditEntry = {
      timestamp: new Date().toISOString(),
      requestId,
      query: this.truncateQuery(query),
      operation: 'BLOCKED',
      status: 'failed',
      reason,
      duration: 0,
      apiKey: this.hashKey(apiKey),
    };

    this.queryBuffer.push(entry);
    this.logger.warn({ ...entry }, 'Failed attempt logged');
  }

  /**
   * Log security event
   */
  logSecurityEvent(
    eventType: string,
    details: any,
    severity: 'low' | 'medium' | 'high' | 'critical'
  ): void {
    if (!this.enableAudit) {
      return;
    }

    const entry = {
      timestamp: new Date().toISOString(),
      eventType,
      severity,
      details,
    };

    this.queryBuffer.push(entry as any);
    this.logger.warn({ ...entry }, 'Security event logged');
  }

  /**
   * Log authentication failure
   */
  logAuthFailure(apiKey: string, reason: string): void {
    this.logSecurityEvent('AUTH_FAILURE', {
      apiKey: this.hashKey(apiKey),
      reason,
    }, 'high');
  }

  /**
   * Log rate limit violation
   */
  logRateLimitViolation(apiKey: string, endpoint: string): void {
    this.logSecurityEvent('RATE_LIMIT_EXCEEDED', {
      apiKey: this.hashKey(apiKey),
      endpoint,
    }, 'medium');
  }

  /**
   * Flush buffer to disk
   */
  private flushBuffer(): void {
    if (this.queryBuffer.length === 0 || !this.writeStream) {
      return;
    }

    const entries = this.queryBuffer.splice(0, this.queryBuffer.length);
    
    entries.forEach(entry => {
      try {
        this.writeStream!.write(JSON.stringify(entry) + '\n');
      } catch (error) {
        this.logger.error(error, 'Failed to write audit log entry');
      }
    });

    // Check log rotation
    this.checkLogRotation();
  }

  /**
   * Check if log file needs rotation
   */
  private checkLogRotation(): void {
    try {
      const stats = fs.statSync(this.auditLogPath);
      if (stats.size > this.maxLogSize) {
        this.rotateLog();
      }
    } catch (error) {
      this.logger.error(error, 'Failed to check log size');
    }
  }

  /**
   * Rotate audit log
   */
  private rotateLog(): void {
    try {
      const timestamp = new Date().toISOString().replace(/[:.]/g, '-');
      const rotatedPath = `${this.auditLogPath}.${timestamp}`;

      if (this.writeStream) {
        this.writeStream.end();
      }

      fs.renameSync(this.auditLogPath, rotatedPath);
      this.writeStream = fs.createWriteStream(this.auditLogPath, { flags: 'a' });

      this.logger.info({ rotatedPath }, 'Audit log rotated');

      // Clean old logs
      this.cleanOldLogs();
    } catch (error) {
      this.logger.error(error, 'Failed to rotate audit log');
    }
  }

  /**
   * Clean old audit logs based on retention policy
   */
  private cleanOldLogs(): void {
    try {
      const retentionDays = parseInt(process.env.AUDIT_LOG_RETENTION_DAYS || '90', 10);
      const logDir = path.dirname(this.auditLogPath);
      const now = Date.now();

      const files = fs.readdirSync(logDir);
      files.forEach(file => {
        if (file.startsWith(path.basename(this.auditLogPath))) {
          const filePath = path.join(logDir, file);
          const stats = fs.statSync(filePath);
          const ageMs = now - stats.mtimeMs;
          const ageDays = ageMs / (1000 * 60 * 60 * 24);

          if (ageDays > retentionDays) {
            fs.unlinkSync(filePath);
            this.logger.debug({ file, ageDays }, 'Deleted old audit log');
          }
        }
      });
    } catch (error) {
      this.logger.error(error, 'Failed to clean old logs');
    }
  }

  /**
   * Get audit entries (for dashboard/reporting)
   */
  async getAuditEntries(
    filter?: {
      startDate?: Date;
      endDate?: Date;
      status?: 'success' | 'failed';
      operation?: string;
    }
  ): Promise<AuditEntry[]> {
    try {
      if (!fs.existsSync(this.auditLogPath)) {
        return [];
      }

      const entries = fs
        .readFileSync(this.auditLogPath, 'utf-8')
        .split('\n')
        .filter(line => line.trim())
        .map(line => JSON.parse(line) as AuditEntry);

      // Apply filters
      return entries.filter(entry => {
        if (filter?.startDate && new Date(entry.timestamp) < filter.startDate) {
          return false;
        }
        if (filter?.endDate && new Date(entry.timestamp) > filter.endDate) {
          return false;
        }
        if (filter?.status && entry.status !== filter.status) {
          return false;
        }
        if (filter?.operation && entry.operation !== filter.operation) {
          return false;
        }
        return true;
      });
    } catch (error) {
      this.logger.error(error, 'Failed to read audit entries');
      return [];
    }
  }

  /**
   * Generate audit report
   */
  async generateReport(startDate: Date, endDate: Date): Promise<any> {
    try {
      const entries = await this.getAuditEntries({ startDate, endDate });

      const summary = {
        totalQueries: entries.length,
        successfulQueries: entries.filter(e => e.status === 'success').length,
        failedQueries: entries.filter(e => e.status === 'failed').length,
        uniqueApiKeys: new Set(entries.map(e => e.apiKey)).size,
        operationBreakdown: this.groupBy(entries, 'operation'),
        averageQueryTime: entries.reduce((sum, e) => sum + (e.duration || 0), 0) / entries.length,
      };

      return summary;
    } catch (error) {
      this.logger.error(error, 'Failed to generate report');
      throw error;
    }
  }

  /**
   * Truncate query for logging
   */
  private truncateQuery(query: string): string {
    return query.substring(0, 500);
  }

  /**
   * Hash API key for logging
   */
  private hashKey(key?: string): string | undefined {
    if (!key) return undefined;
    
    const crypto = require('crypto');
    return crypto
      .createHash('sha256')
      .update(key)
      .digest('hex')
      .substring(0, 8);
  }

  /**
   * Group array by property
   */
  private groupBy(array: any[], property: string): any {
    return array.reduce((groups, item) => {
      const key = item[property];
      groups[key] = (groups[key] || 0) + 1;
      return groups;
    }, {});
  }

  /**
   * Graceful shutdown
   */
  async shutdown(): Promise<void> {
    if (this.bufferFlushInterval) {
      clearInterval(this.bufferFlushInterval);
    }

    this.flushBuffer();

    if (this.writeStream) {
      return new Promise((resolve, reject) => {
        this.writeStream!.end(() => {
          this.logger.info('Audit logger shutdown complete');
          resolve();
        });
      });
    }
  }
}

export default AuditLogger;

