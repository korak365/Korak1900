import 'dotenv/config';
import { MCPServer } from './mcp-server';
import { GeminiClient } from './gemini-bridge';
import { AuditLogger } from './audit-logger';

import pino from 'pino';

const logger = pino();

async function main() {
  try {
    // Validate environment
    const requiredEnvVars = [
      'GEMINI_API_KEY',
      'DATABASE_PATH',
      'API_KEYS',
      'API_SECRET_KEY'
    ];

    for (const envVar of requiredEnvVars) {
      if (!process.env[envVar]) {
        throw new Error(`Missing required environment variable: ${envVar}`);
      }
    }

    logger.info('Starting MCP SQLite Gemini Bridge...');

    // Initialize components
    const gemini = new GeminiClient();
    const auditLogger = new AuditLogger();
    const server = new MCPServer(gemini, auditLogger);

    // Start server
    const port = parseInt(process.env.MCP_PORT || '3000', 10);
    await server.start(port);

    logger.info(`Bridge running on port ${port}`);

    // Graceful shutdown
    process.on('SIGTERM', async () => {
      logger.info('Shutting down gracefully...');
      await server.stop();
      await auditLogger.shutdown();
      process.exit(0);
    });

  } catch (error) {
    logger.error(error, 'Fatal error');
    process.exit(1);
  }
}

main();

import express, { Express, Request, Response } from 'express';
import https from 'https';
import fs from 'fs';
import { SecurityLayer } from './security';
import { SQLiteHandler } from './sqlite-handler';
import { GeminiClient } from './gemini-bridge';
import { AuditLogger } from './audit-logger';
import pino from 'pino';

export class MCPServer {
  private app: Express;
  private logger = pino();
  private security: SecurityLayer;
  private sqlite: SQLiteHandler;
  private gemini: GeminiClient;
  private auditLogger: AuditLogger;

  constructor(gemini: GeminiClient, auditLogger: AuditLogger) {
    this.app = express();
    this.gemini = gemini;
    this.auditLogger = auditLogger;
    this.security = new SecurityLayer();
    this.sqlite = new SQLiteHandler();

    this.setupMiddleware();
    this.setupRoutes();
  }

  private setupMiddleware(): void {
    this.app.use(express.json());

    // Authentication middleware
    this.app.use((req: Request, res: Response, next) => {
      const apiKey = req.headers['x-api-key'] as string;
      
      if (!apiKey) {
        return res.status(401).json({ error: 'Missing API key' });
      }

      if (!this.security.validateApiKey(apiKey)) {
        this.auditLogger.logAuthFailure(apiKey, 'Invalid API key');
        return res.status(401).json({ error: 'Invalid API key' });
      }

      // Check rate limit
      if (!this.security.checkRateLimit(apiKey)) {
        this.auditLogger.logRateLimitViolation(apiKey, req.path);
        return res.status(429).json({ error: 'Rate limit exceeded' });
      }

      req.user = { apiKey };
      next();
    });
  }

  private setupRoutes(): void {
    // Health check
    this.app.get('/health', (req: Request, res: Response) => {
      res.json({ status: 'ok', timestamp: new Date().toISOString() });
    });

    // Get database schema
    this.app.get('/tools/get_schema', async (req: Request, res: Response) => {
      try {
        const requestId = this.generateRequestId();
        const schema = await this.sqlite.getSchema();
        this.auditLogger.logQuery(requestId, 'SCHEMA_INFO', 'SCHEMA', 0);
        res.json(schema);
      } catch (error: any) {
        this.logger.error(error);
        res.status(500).json({ error: error.message });
      }
    });

    // Get table info
    this.app.get('/tools/get_table_info/:table', async (req: Request, res: Response) => {
      try {
        const requestId = this.generateRequestId();
        const { table } = req.params;
        const info = await this.sqlite.getTableInfo(table);
        res.json(info);
      } catch (error: any) {
        this.logger.error(error);
        res.status(500).json({ error: error.message });
      }
    });

    // Execute query
    this.app.post('/tools/query_database', async (req: Request, res: Response) => {
      try {
        const requestId = this.generateRequestId();
        const { query } = req.body;
        const apiKey = req.headers['x-api-key'] as string;

        // Validate query
        if (!this.security.validateQuery(query)) {
          this.auditLogger.logFailedAttempt(requestId, query, 'Query validation failed', apiKey);
          return res.status(400).json({ error: 'Invalid query' });
        }

        const startTime = Date.now();
        const results = await this.sqlite.executeQuery(query);
        const duration = Date.now() - startTime;

        this.auditLogger.logQuery(requestId, query, 'SELECT', results.length, duration, apiKey);
        res.json({ results, rowCount: results.length });
      } catch (error: any) {
        this.logger.error(error);
        res.status(500).json({ error: error.message });
      }
    });

    // Aggregate function
    this.app.post('/tools/execute_aggregate', async (req: Request, res: Response) => {
      try {
        const requestId = this.generateRequestId();
        const { function: func, table, column } = req.body;
        
        const result = await this.sqlite.executeAggregate(func, table, column);
        this.auditLogger.logQuery(requestId, `${func}(${column}) FROM ${table}`, func, 1);
        res.json({ result });
      } catch (error: any) {
        this.logger.error(error);
        res.status(500).json({ error: error.message });
      }
    });

    // Agent query
    this.app.post('/agent/query', async (req: Request, res: Response) => {
      try {
        const { message, sessionId } = req.body;
        const apiKey = req.headers['x-api-key'] as string;
        
        const response = await this.gemini.processAgentQuery(message, sessionId, this.sqlite);
        res.json({ response });
      } catch (error: any) {
        this.logger.error(error);
        res.status(500).json({ error: error.message });
      }
    });

    // Audit logs
    this.app.get('/admin/audit-logs', async (req: Request, res: Response) => {
      try {
        const entries = await this.auditLogger.getAuditEntries();
        res.json({ entries });
      } catch (error: any) {
        this.logger.error(error);
        res.status(500).json({ error: error.message });
      }
    });
  }

  async start(port: number): Promise<void> {
    return new Promise((resolve) => {
      const tlsCert = process.env.TLS_CERT_PATH;
      const tlsKey = process.env.TLS_KEY_PATH;

      if (tlsCert && tlsKey && fs.existsSync(tlsCert) && fs.existsSync(tlsKey)) {
        const options = {
          cert: fs.readFileSync(tlsCert),
          key: fs.readFileSync(tlsKey),
        };
        https.createServer(options, this.app).listen(port, () => {
          this.logger.info(`HTTPS server listening on port ${port}`);
          resolve();
        });
      } else {
        this.app.listen(port, () => {
          this.logger.info(`HTTP server listening on port ${port}`);
          resolve();
        });
      }
    });
  }

  async stop(): Promise<void> {
    await this.sqlite.close();
  }

  private generateRequestId(): string {
    return `req-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;
  }
}

import sqlite3 from 'sqlite3';
import pino from 'pino';

export class SQLiteHandler {
  private db: sqlite3.Database;
  private logger = pino();
  private queryTimeout: number = parseInt(process.env.MAX_QUERY_TIMEOUT_MS || '30000', 10);
  private maxRows: number = parseInt(process.env.MAX_RESULT_ROWS || '10000', 10);

  constructor() {
    const dbPath = process.env.DATABASE_PATH || './data/database.sqlite';
    this.db = new sqlite3.Database(dbPath, (err) => {
      if (err) {
        this.logger.error(err, 'Database connection error');
      } else {
        this.logger.info(`Connected to database: ${dbPath}`);
      }
    });
  }

  async executeQuery(query: string): Promise<any[]> {
    return new Promise((resolve, reject) => {
      const timeout = setTimeout(() => {
        reject(new Error('Query timeout'));
      }, this.queryTimeout);

      this.db.all(query, (err: Error | null, rows: any[]) => {
        clearTimeout(timeout);
        if (err) {
          reject(err);
        } else {
          resolve(rows.slice(0, this.maxRows));
        }
      });
    });
  }

  async getSchema(): Promise<any> {
    return new Promise((resolve, reject) => {
      this.db.all(
        "SELECT name FROM sqlite_master WHERE type='table'",
        (err: Error | null, tables: any[]) => {
          if (err) {
            reject(err);
          } else {
            resolve({ tables: tables.map(t => t.name) });
          }
        }
      );
    });
  }

  async getTableInfo(table: string): Promise<any> {
    return new Promise((resolve, reject) => {
      this.db.all(`PRAGMA table_info(${table})`, (err: Error | null, columns: any[]) => {
        if (err) {
          reject(err);
        } else {
          resolve({ table, columns });
        }
      });
    });
  }

  async executeAggregate(func: string, table: string, column: string): Promise<number> {
    const query = `SELECT ${func}(${column}) as result FROM ${table}`;
    return new Promise((resolve, reject) => {
      this.db.get(query, (err: Error | null, row: any) => {
        if (err) {
          reject(err);
        } else {
          resolve(row.result);
        }
      });
    });
  }

  async close(): Promise<void> {
    return new Promise((resolve, reject) => {
      this.db.close((err: Error | null) => {
        if (err) reject(err);
        else {
          this.logger.info('Database connection closed');
          resolve();
        }
      });
    });
  }
}

import crypto from 'crypto';
import pino from 'pino';

export class SecurityLayer {
  private logger = pino();
  private rateLimitMap: Map<string, { count: number; resetTime: number }> = new Map();
  private allowedApiKeys: Set<string>;
  private blockedOperations = ['DROP', 'DELETE', 'TRUNCATE', 'ALTER', 'INSERT', 'UPDATE'];

  constructor() {
    const apiKeys = (process.env.API_KEYS || '').split(',');
    this.allowedApiKeys = new Set(apiKeys.map(k => this.hashKey(k)));
  }

  validateApiKey(apiKey: string): boolean {
    const hashed = this.hashKey(apiKey);
    return this.allowedApiKeys.has(hashed);
  }

  validateQuery(query: string): boolean {
    const upperQuery = query.toUpperCase().trim();

    // Block dangerous operations
    for (const op of this.blockedOperations) {
      if (upperQuery.startsWith(op)) {
        this.logger.warn(`Blocked operation: ${op}`);
        return false;
      }
    }

    // Check for SQL injection patterns
    const injectionPatterns = [
      /--/g, // SQL comments
      /\/\*/g, // Block comments
      /UNION/i,
      /EXEC/i,
      /EXECUTE/i,
    ];

    for (const pattern of injectionPatterns) {
      if (pattern.test(query)) {
        this.logger.warn('SQL injection pattern detected');
        return false;
      }
    }

    return true;
  }

  checkRateLimit(apiKey: string): boolean {
    const perMinute = parseInt(process.env.RATE_LIMIT_PER_MINUTE || '100', 10);
    const now = Date.now();
    const key = this.hashKey(apiKey);

    if (!this.rateLimitMap.has(key)) {
      this.rateLimitMap.set(key, { count: 1, resetTime: now + 60000 });
      return true;
    }

    const limit = this.rateLimitMap.get(key)!;

    if (now > limit.resetTime) {
      limit.count = 1;
      limit.resetTime = now + 60000;
      return true;
    }

    limit.count++;
    return limit.count <= perMinute;
  }

  private hashKey(key: string): string {
    return crypto.createHash('sha256').update(key).digest('hex');
  }
}


import { GoogleGenerativeAI } from '@google/generative-ai';
import { SQLiteHandler } from './sqlite-handler';
import pino from 'pino';

export class GeminiClient {
  private client: GoogleGenerativeAI;
  private model: string;
  private logger = pino();
  private sessions: Map<string, any> = new Map();

  constructor() {
    const apiKey = process.env.GEMINI_API_KEY!;
    this.client = new GoogleGenerativeAI(apiKey);
    this.model = process.env.GEMINI_MODEL || 'gemini-pro';
  }

  async processAgentQuery(
    message: string,
    sessionId: string,
    sqlite: SQLiteHandler
  ): Promise<string> {
    try {
      // Get or create session
      let session = this.sessions.get(sessionId);
      if (!session) {
        session = { history: [], model: this.client.getGenerativeModel({ model: this.model }) };
        this.sessions.set(sessionId, session);
      }

      // Prepare context
      const dbSchema = await sqlite.getSchema();
      const systemPrompt = `You are a database assistant. You have access to a SQLite database with the following schema: ${JSON.stringify(dbSchema)}. Help the user query this database. Always explain what you're doing.`;

      // Add to history and get response
      session.history.push({ role: 'user', parts: [{ text: message }] });

      const response = await session.model.generateContent({
        contents: session.history,
        systemInstruction: systemPrompt,
      });

      const responseText = response.response.text();
      session.history.push({ role: 'model', parts: [{ text: responseText }] });

      return responseText;
    } catch (error: any) {
      this.logger.error(error);
      throw error;
    }
  }

  clearSession(sessionId: string): void {
    this.sessions.delete(sessionId);
  }
}

